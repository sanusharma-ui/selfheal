# Copy to .env in the directory where you run the app.
# Existing process environment variables take precedence over .env.
# true selects Groq; false selects OpenAI. Only the selected provider is used.
SELFHEAL_USE_GROQ=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional legacy ordering when SELFHEAL_USE_GROQ is absent.
SELFHEAL_PROVIDER_PRIORITY=groq,openai

# ONE total repair budget, including provider retries, verification, review and
# activation. 1..3600 seconds; process env > .env; explicit SDK/TOML values win.
SELFHEAL_REPAIR_TIMEOUT_SECONDS=180
# Reserved INSIDE that total for cleanup/rollback (capped at 10% of the total).
SELFHEAL_TIMEOUT_CLEANUP_SECONDS=5
# Fail-stop for uninterruptible native callbacks: terminates the owning app if
# it cannot unwind by the hard deadline. A process supervisor must restart it.
# false retains cooperative timeouts but cannot bound arbitrary native stalls.
SELFHEAL_HARD_TIMEOUT=true
