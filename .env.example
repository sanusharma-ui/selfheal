# Copy to .env in the directory where you run the app.
# Existing process environment variables take precedence over .env.
# true selects Groq; false selects OpenAI. Only the selected provider is used.
SELFHEAL_USE_GROQ=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional legacy ordering when SELFHEAL_USE_GROQ is absent.
SELFHEAL_PROVIDER_PRIORITY=groq,openai
